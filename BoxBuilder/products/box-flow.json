{
  "schemaVersion": 1,
  "name": "box-flow",
  "output": "box.Flow",
  "packages": [
    {
      "name": "backend-flow",
      "destination": "backend-flow",
      "source": {
        "type": "git",
        "repository": "https://api.sc-ci.sber.ru/Export/backend-flow.git",
        "branch": "mvp"
      },
      "commands": {
        "prepare": "node core/command/build",
        "start": "node server.js",
        "db": "npm run db:renew",
        "updatedb": "npm run db:collect && npm run db:migrate:up && npm run db:dumps:restorewin",
        "env": {
          "PORT": "3080"
        }
      }
    },
        {
      "name": "frontend-flow",
      "destination": "frontend-flow",
      "source": {
        "type": "git",
        "repository": "https://api.sc-ci.sber.ru/Export/frontend-flow.git",
        "branch": "main"
      },
      "commands": {
        "start": "npm run start",
        "env": {
          "PORT": "3000",
          "BROWSER": "none"
        }
      }
    },
        {
      "name": "frontend-admin",
      "destination": "frontend-admin",
      "source": {
        "type": "git",
        "repository": "https://api.sc-ci.sber.ru/Export/frontend-admin.git",
        "branch": "develop"
      },
      "commands": {
        "clean": ["build", "@mf-types"],
        "start": "npm exec -- craco start",
        "env": {
          "PORT": "3001",
          "ESLINT_NO_DEV_ERRORS": "true",
          "DISABLE_ESLINT_PLUGIN": "true",
          "BROWSER": "none"
        }
      }
    }
  ]
}
