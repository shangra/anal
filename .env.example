# Скопируйте в .env в корне (рядом с package.json) и заполните БД заказчика.
# Коробка сама разложит эти значения в pivot / админку / аналитику / миграции.

NODE_ENV=development

# --- PostgreSQL заказчика (обязательно) ---
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASS=
DB_DATABASE=
# Новая схема в базе заказчика (коробка сделает CREATE SCHEMA)
DB_SCHEMA=pivot
DB_TEST_DATABASE=
DB_DIALECT=postgres
DB_POOL={"max":300,"min":0,"idle":1000}

# TLS к Postgres ставится сам:
#   удалённый хост → require (иначе логин 500: no encryption)
#   localhost / 127.0.0.1 → disable
# Явно задавайте только если нужен туннель 127.0.0.1 к облачной БД:
# DB_SSL=require
# DB_SSL_REJECT_UNAUTHORIZED=false

# --- Порты сервисов коробки ---
PIVOT_PORT=3391
ADMIN_PORT=3372
MF_TYPES_PORT=33702
SPREADSHEET_PORT=3380

# Pivot как API для админки/аналитики (без отдельной ESB)
ESB_HOST=localhost:3391
ANALYTIC_HOST=http://localhost:3391

SESSION_SECRET=change-me
CONNECTOR_SALT=change-me

# После npm run db можно прописать ключ (или ввести по запросу)
LICENSE_KEY=

# HTTP-сертификаты приложения, не Postgres. Обычно пусто.
SERVER_KEY=
SERVER_CERT=
SERVER_CA=
CLIENT_CA=
