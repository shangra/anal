# Скопируйте в .env и заполните своими значениями.
# Коробка не ходит в «зашитую» БД — только в то, что указано здесь.
# Затем: npm run env  →  npm run db  →  npm start

NODE_ENV=development

# --- PostgreSQL (обязательно) ---
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASS=
DB_DATABASE=
DB_SCHEMA=pivot
DB_TEST_DATABASE=
DB_DIALECT=postgres
DB_POOL={"max":300,"min":0,"idle":1000}

# SSL к Postgres. Для облачных БД (ошибка «no encryption») — require.
# localhost без SSL: DB_SSL=disable
DB_SSL=require
DB_SSL_REJECT_UNAUTHORIZED=false

# --- Порты сервисов коробки ---
PIVOT_PORT=3391
ADMIN_PORT=3372
MF_TYPES_PORT=33702
SPREADSHEET_PORT=3380

# Pivot как API для админки/аналитики (без отдельной ESB)
ESB_HOST=localhost:3391
ANALYTIC_HOST=http://localhost:3391

SESSION_SECRET=change-me
CONNECTOR_SALT=change-me

# После npm run db можно прописать ключ (или ввести по запросу)
LICENSE_KEY=

# SSL (нужны только если CHECK_CERT=true у pivot)
SERVER_KEY=
SERVER_CERT=
SERVER_CA=
CLIENT_CA=
