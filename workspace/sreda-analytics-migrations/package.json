{
    "name": "sreda-pivot",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "core:collect": "node core/command/build",
        "db:collect": "node core/command/extdb",
        "db:drop": "node ext_modules/test-cms/src/dropAllTables.js",
        "db:migrate:up": "npm run db:collect && node core/command/patroni -y db:migrate",
        "db:migrate:down": "npm run db:collect && node core/command/patroni db:migrate:undo",
        "db:migrate:down:all": "npm run db:collect && node core/command/patroni db:migrate:undo:all",
        "db:seed:up": "npm run db:collect && node core/command/patroni -y db:seed:all",
        "db:dumps:restore": "npm run db:collect && node core/command/dumpdb -r var/development/db/dumps/ --recurse",
        "db:dumps:backup": "npm run db:collect && node core/command/dumpdb -db -o var/development/db/backups/ --now",
        "db:renew": "npm run db:collect && npm run db:migrate:down:all && npm run db:migrate:up && npm run db:seed:up && npm run db:dumps:restore",
        "db:up": "npm run core:collect && npm run db:collect && npm run db:migrate:up && npm run db:seed:up && npm run db:dumps:restore",
        "pretest": "export NODE_ENV=test; (npm run db:drop && npm run db:migrate:up && npm run db:seed:up && npm run db:dumps:restore)",
        "test": "export NODE_ENV=test; (find ./ext_modules/* -name \"package.json\" -type f -maxdepth 1 -print0 | xargs -0 -n1 sh -c 'cd \"$(dirname $0)\" && (npm test || exit 255)')",
        "predev": "npm run core:collect",
        "dev": "nodemon --trace-warnings --no-lazy --inspect=0.0.0.0:9229 server.js",
        "start": "npm run core:collect && node server.js",
        "readme": "node core/command/readme",
        "obfuscate:build": "node core/command/build/obfuscate.js",
        "bytecode:build": "node core/command/build/bytecodeCompile.js",
        "start:bytecode": "node loader.js",
        "build:bundle": "npx rollup -c rollup.config.cjs",
        "build:obfuscate": "node core/command/build/obfuscateBundle.js",
        "build:binary": "npx boxednode -s dist-temp/bundle-obf.js -t dist/pivot",
        "db": "npm run core:collect && npm run db:renew",
        "updatedb": "npm run core:collect && npm run db:up",
        "build:binary2": "BOXEDNODE_CONFIGURE_ARGS='[\"--without-npm\"]' npx boxednode -s dist-temp/bundle-obf.js -t dist/pivot",
        "docker:db": "npm run db:renew",
        "docker:updatedb": "npm run db:up",
        "docker:ci": "npm install --legacy-peer-deps",
        "docker:start": "node server.js"
    },
