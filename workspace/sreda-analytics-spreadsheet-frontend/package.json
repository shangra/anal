{
  "name": "sreda-analytics-spreadsheet-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "cross-env npm run refresh-module-federation-files && ESLINT_NO_DEV_ERRORS=true craco start",
    "start-win": "cross-env npm run refresh-module-federation-files && set ESLINT_NO_DEV_ERRORS=true && craco start",
    "start:debug": "npm run refresh-module-federation-files && ESLINT_NO_DEV_ERRORS=true craco start --debug",
    "build:local": "cross-env DISABLE_ESLINT_PLUGIN=true craco build",
    "build:analyze": "cross-env DISABLE_ESLINT_PLUGIN=true craco build --analyze-only",
    "build": "cross-env HTTPS=true DISABLE_ESLINT_PLUGIN=true BUILD_PATH=bi_ui_build craco build --verbose --debug",
    "storybook": "cross-env DISABLE_ESLINT_PLUGIN=true storybook dev -p 6006 --debug-webpack",
    "build-storybook": "storybook build",
    "eslint": "cross-env-shell eslint $FILES $ADDITIONAL_FLAG --fix --config=.eslintrc.js",
    "prettier": "cross-env-shell prettier $FILES --write",
    "ts-check": "tsc",
    "prepare": "husky",
    "refresh-module-federation-files": "rm -rf build && rm -rf @mf-types",
    "test": "jest src/__tests__/"
  },
